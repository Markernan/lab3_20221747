<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF6E9"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#4CAF50"
        android:gravity="center"
        android:text="Contador"
        android:textColor="#2E4057"
        android:textSize="32sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Valor actual"
            android:textColor="#2E4057"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvCounterValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp"
            android:text="0"
            android:textColor="#2E4057"
            android:textSize="72sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(cuenta del 1 al 20)"
            android:textColor="#757575"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="#F44336"
            android:text="Regresar"
            android:textColor="#FFFFFF"
            app:cornerRadius="28dp" />

        <Button
            android:id="@+id/btnStartCounter"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#1A1B76"
            android:text="Iniciar contador"
            android:textColor="#FFFFFF"
            app:cornerRadius="28dp" />

    </LinearLayout>
</LinearLayout>