<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF6E9"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#4CAF50"
        android:gravity="center"
        android:text="¡Bienvenido!"
        android:textColor="#2E4057"
        android:textSize="32sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnGoToCounter"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#1A1B76"
            android:text="Ir al Contador"
            android:textColor="#FFFFFF"
            app:cornerRadius="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckConnection"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#F44336"
            android:text="Comprobar Conexión"
            android:textColor="#FFFFFF"
            app:cornerRadius="28dp"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="#FFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="24dp"
            android:background="#D1D1D1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="Buscador de películas"
            android:textColor="#2E4057"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMovieId"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="idPelícula (IMDb)"
            android:paddingHorizontal="16dp" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#4CAF50"
            android:text="Buscar"
            android:textColor="#FFFFFF"
            app:cornerRadius="28dp" />

    </LinearLayout>
</LinearLayout>